# FreshFlow Web — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is committed, so
# keep real keys out of it.
#
#   cp .env.example .env
#
# Values are baked into the browser bundle at build time by
# `scripts/generate-env.mjs` (runs automatically before start/build/test).
# A variable already set in the real environment overrides the file, which is
# how CI injects secrets without writing one.
#
# API_BASE_URL is required — the build fails without it. The Goong keys may be
# left blank; only the map features stop working.
#
# ⚠ Everything here ships to the browser. Never put a server-side secret in it.

# Backend origin used by the generated API client. REQUIRED.
# Local backend: http://localhost:8080
API_BASE_URL=

# Goong.io keys (https://account.goong.io) — client-side, visible in the bundle.
# GOONG_MAPS_KEY   = Maptiles key, used by the map SDK.
# GOONG_PLACES_KEY = REST key, used by Places autocomplete / geocoding.
GOONG_MAPS_KEY=
GOONG_PLACES_KEY=

# Cloudinary cloud that serves media (https://console.cloudinary.com).
# Delivery side only — this names the account whose public URLs the browser
# fetches. The API key and secret belong to the BACKEND, which mints upload
# signatures; neither ever appears here.
CLOUDINARY_CLOUD_NAME=
