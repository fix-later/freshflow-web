{
  "name": "fuse-angular",
  "version": "20.0.0",
  "description": "Fuse - Angular Admin Template and Starter Project",
  "author": "https://themeforest.net/user/srcn",
  "license": "https://themeforest.net/licenses/standard",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve -c local",
    "start:clean": "ng cache clean && ng serve",
    "build": "ng build",
    "build:local": "ng build -c local",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "generate:api": "node scripts/generate-api.mjs",
    "prepare": "husky",
    "precheck": "npm run lint && npx prettier --check \"src/**/*.{ts,html,scss,json}\" && npm run test:ci && npm run build -- --configuration production"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,html,scss,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/material": "22.0.0",
    "@angular/material-luxon-adapter": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "22.0.0",
    "@angular/router": "22.0.0",
    "@jsverse/transloco": "^8.4.0",
    "apexcharts": "^5.13.0",
    "crypto-js": "4.2.0",
    "highlight.js": "11.9.0",
    "lodash-es": "4.17.21",
    "luxon": "3.7.2",
    "ng-apexcharts": "^2.4.0",
    "ngx-quill": "^31.0.0",
    "perfect-scrollbar": "1.5.5",
    "quill": "2.0.2",
    "rxjs": "^7.8.2",
    "tslib": "2.6.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@angular/language-service": "^22.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/chroma-js": "2.4.4",
    "@types/crypto-js": "4.2.2",
    "@types/highlight.js": "10.1.0",
    "@types/jasmine": "5.1.4",
    "@types/lodash": "4.17.4",
    "@types/lodash-es": "4.17.12",
    "@types/luxon": "3.4.2",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.0",
    "chokidar": "5.0.0",
    "chroma-js": "2.4.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.1.2",
    "karma": "6.4.3",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "lint-staged": "^17.0.7",
    "lodash": "4.17.21",
    "postcss": "^8.5.15",
    "prettier": "3.3.0",
    "prettier-plugin-organize-imports": "3.2.4",
    "prettier-plugin-tailwindcss": "0.6.1",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
